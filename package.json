{
  "name": "@yukitakasama/dsh-wsl-preset",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: installs the 'wsl' agent preset — the Windows WSL variant of the standard preset that routes the bash tool through Windows Subsystem for Linux (WSL), with automatic shell discovery and sandbox-aware gating.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "agent-presets",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check agent-presets/wsl/wsl-executor.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "wsl",
    "windows-subsystem-for-linux",
    "linux",
    "windows"
  ],
  "license": "MIT",
  "author": "yukitakasama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukitakasama/dsh-wsl-preset.git"
  },
  "bugs": {
    "url": "https://github.com/yukitakasama/dsh-wsl-preset/issues"
  },
  "homepage": "https://github.com/yukitakasama/dsh-wsl-preset#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
